{
  "name": "minnano-hyouban",
  "version": "1.0.0",
  "description": "みんなの評判.com — ニュース掲載企業を公開情報から調べる個人運営メディア",
  "private": true,
  "scripts": {
    "add-article":    "node scripts/add-article.js",
    "validate":       "node scripts/validate-articles.js",
    "validate-schema":"node scripts/validate-schema.js",
    "compile-drafts": "node scripts/compile-drafts.js",
    "sitemap":        "node scripts/generate-sitemap.js",
    "feed":           "node scripts/generate-feed.js",
    "llms":           "node scripts/generate-llms.js",
    "ai-instruction": "node scripts/generate-ai-instruction.js",
    "aio-concepts":   "node scripts/generate-aio-concepts.js",
    "build-aio":      "node scripts/build-aio.js",
    "ai-patch":       "node scripts/generate-ai-patch.js",
    "ai-query-map":   "node scripts/generate-ai-query-map.js",
    "static":         "node scripts/generate-static-articles.js",
    "webp":           "node scripts/convert-webp.js",
    "indexing":       "node scripts/request-indexing.js",
    "dev":            "npm run build && npx serve dist --listen 8080",
    "prebuild":       "node scripts/validate-public-v2.js",
    "build":          "node scripts/build-public-v2.js",
    "build:branch-root": "npm run build && node scripts/stage-branch-root.js"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
